{
  "schema_version": "1.0",
  "project": "Autonomous Racing Systems",
  "prerequisites": {
    "install": "python -m pip install -e . --no-deps && python -m pip install -r requirements-report.txt",
    "env": {
      "PYTHONPATH": "gym",
      "MPLBACKEND": "Agg"
    },
    "note": "Every command below assumes these. PYTHONPATH=gym is required because this repository's own gym/ directory must shadow the third-party gym package for the vendored f110_gym imports to resolve; without it the generators fail at import. MPLBACKEND=Agg is required for headless runs.",
    "numeric_gate": "reports/figures/dynamic_replay_*.png are NOT byte-comparable: the renderer moves glyphs and layout between font builds. Compare runs/dynamic_model_replay/metrics.csv instead, via experiments/test_replay_metrics.py (tolerance 1e-9 relative; observed cross-run spread 1e-15)."
  },
  "figures": [
    {
      "id": "ope-archive-structure",
      "evidence_type": "raw archive structural counts",
      "generator": "experiments/plot_ope_structure.py",
      "command": "python experiments/plot_ope_structure.py --result runs/ope_qualification/result.json --output runs/ope_qualification/structure.png",
      "inputs": [
        "runs/ope_qualification/result.json"
      ],
      "outputs": [
        "runs/ope_qualification/structure.png",
        "runs/ope_qualification/structure.svg",
        "runs/ope_qualification/structure.md",
        "runs/ope_qualification/structure.csv",
        "runs/ope_qualification/loader_aliases.csv"
      ],
      "environment": "requirements-ope-qualification.txt, Python 3.11; overrides historical prerequisites",
      "caption": "Unfiltered structural counts: recording segments, policy-name strings and terminal-flag alignment. Episode semantics and execution remain unresolved.",
      "input_sha256": {
        "runs/ope_qualification/result.json": "eafc1c220d3774a10aaba85ed0ce96e42fead88811aeacf419c7c53339693f2b"
      },
      "notes": "Presentation-only rendering from the frozen result. Qualification script and result provenance are unchanged."
    },
    {
      "id": "public-command-response",
      "evidence_type": "same-run public-car development fit; uncalibrated frame and timing",
      "generator": "experiments/plot_real_command_response.py",
      "command": "python experiments/plot_real_command_response.py --run-dir runs/real_command_response --output runs/real_command_response/comparison.png",
      "inputs": [
        "runs/real_command_response/comparison.csv",
        "runs/real_command_response/result.json",
        "runs/real_command_response/delay_profile.json"
      ],
      "outputs": [
        "runs/real_command_response/comparison.png",
        "runs/real_command_response/comparison.svg",
        "runs/real_command_response/comparison_metrics.md",
        "runs/real_command_response/comparison_metrics.csv"
      ],
      "environment": "requirements-ope-qualification.txt, Python 3.11; overrides historical prerequisites",
      "caption": "Motion, commands and existing delay search on the same correlated development samples. No held-out evaluation or uncertainty band.",
      "notes": "No bag access or refitting. Full CSV retained, with the original display-gap rule; metric table is a generated view of result.json.",
      "input_sha256": {
        "runs/real_command_response/comparison.csv": "fe010c7d6fdf5f80b99fb9a8e222a38e5fd2640ccf4c0b4303d1926fe3497ef9",
        "runs/real_command_response/result.json": "d2e2c44dea912ae7fb43d6e743b436135ee7d91be6a1ece9230b847836d03e79",
